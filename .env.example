# Copy to .env and adjust. All values are optional; sensible defaults apply.
BUMBLEWICK_DB_PATH=bumblewick.db
# Refunds at/under this many cents are auto-approved; larger ones need confirm=true.
BUMBLEWICK_AUTO_REFUND_LIMIT_CENTS=2000
# Max refunds per customer within the rolling window.
BUMBLEWICK_REFUND_RATE_LIMIT=3
BUMBLEWICK_REFUND_RATE_WINDOW_HOURS=24
